{
  "rules": {
    ".read": false,
    ".write": false,

    "stato": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'EMAIL_DELLA_GUIDA@esempio.it'"
    },

    "partite": {
      ".read": "auth != null && auth.token.email == 'EMAIL_DELLA_GUIDA@esempio.it'",
      ".write": "auth != null && auth.token.email == 'EMAIL_DELLA_GUIDA@esempio.it'"
    },

    "codici": {
      ".read": "auth != null && auth.token.email == 'EMAIL_DELLA_GUIDA@esempio.it'",
      ".write": "auth != null && auth.token.email == 'EMAIL_DELLA_GUIDA@esempio.it'",
      ".indexOn": ["partita"],
      "$codice": {
        ".read": true
      }
    }
  }
}
